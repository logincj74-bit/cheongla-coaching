{
  "name": "cheongla-mobile",
  "version": "0.1.0",
  "private": true,
  "engines": { "node": ">=22" },
  "scripts": {
    "build": "node scripts/build.mjs",
    "check": "node scripts/check.mjs",
    "add:android": "cap add android",
    "add:ios": "cap add ios",
    "configure": "node scripts/configure-native.mjs",
    "sync": "cap sync && npm run configure",
