    "ios": "cap open ios"
  },
  "dependencies": {
    "@capacitor/core": "8.5.3",
    "@capacitor/android": "8.5.3",
    "@capacitor/ios": "8.5.3",
    "@capacitor/app": "8.1.2",
    "@capacitor/browser": "8.0.5",
    "@capacitor/camera": "8.2.5",
    "@supabase/supabase-js": "2.57.4"
  },
  "devDependencies": { "@capacitor/cli": "8.5.3", "esbuild": "0.28.2" }
}
